# Copy to .env.local and fill in. Leads from every form on the site are emailed here.
# Hostinger mail example: host smtp.hostinger.com, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Comma-separated list of inboxes that should receive leads
LEAD_EMAIL_TO=info@onegrowlearning.com
# Optional; defaults to the SMTP user
LEAD_EMAIL_FROM=
